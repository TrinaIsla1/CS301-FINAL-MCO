PORT=4000
CLIENT_ORIGIN=http://localhost:8081
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: keep on the server only. Never put it in the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Set to 1 when the API runs behind a reverse proxy (so rate limits see real visitor IPs).
TRUST_PROXY=0
